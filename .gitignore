# Python/R stacks from make setup; no trailing slash, so a symlinked .venv/.rlib is still ignored.
.venv
.rlib
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

*.dat
*_f32.dat
# Any locally downloaded .h5ad
*.h5ad

# Raw external data, not committed; the fetch and subset scripts are outside this reproduction subset. Every input the build needs is committed under data/. Per-file provenance is documented in figure_data/PROVENANCE.md and DATA_AVAILABILITY.md.
/data/raw/*
!/data/raw/.gitkeep

# Local reference copies of the source figures, used only for visual diffing; no build step consumes them.
/.reference_figures/

# pytest
.pytest_cache/

# See REPRODUCIBILITY.md.
/logs/

# outputs/ is stage-1 scratch; nothing here is committed. See REPRODUCIBILITY.md.
/outputs/

# data/derived/ is regenerated by make_enrichment_table.py
/data/derived/*.csv

# figure_data/ is committed, not ignored. See REPRODUCIBILITY.md.

# Regenerated final_plots outputs, each produced under src/figures/. final_plots/pdf/ is the only directory rule below. See REPRODUCIBILITY.md.
/final_plots/pdf/
/final_plots/genetic_data.png
/final_plots/perturbational_functional_genomics_with_thde.png
/final_plots/figure_model_analysis_composite.png
/final_plots/figure_trial_validation_immune_stages_R.png
/final_plots/figure_stat4_vignette.png
/final_plots/specificity_immune_vs_cardiac_faceted.png
/final_plots/figure_prospective_temporal_holdout.png
/final_plots/figure_label_permutation.png
/final_plots/supplementary/leakage_controlled_comparison.png
/final_plots/supplementary/figure_discordance_genetics_vs_full.png

/final_outputs/
/supplementary/
/export/

/.verify_figures.tmp
/.verify_figures.cls


# Perturb-seq knockdown signature matrices, not committed (size). See REPRODUCIBILITY.md.
/data/perturbseq/knn/*.npy

/figure_data/discordance_evidence.csv
/figure_data/discordance_go_background_comparison.csv
/figure_data/discordance_go_enrichment_full.csv
/figure_data/t0_recovery_at_k.csv

# Overnight run logs from the opt-in permutation target (tee'd by the wrapper script).
/overnight_permutation.*.log

# Local copy of the upstream 54-column HGNC complete set. The committed four-column
# projection at data/perturbseq/sources/hgnc_symbol_subset.txt is what the build reads;
# this 16 MB original is kept locally for reference only.
/data/reference/hgnc_complete_set.txt
